{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "garanti-route": {
        "ClusterId": "garanti-cluster",
        "Match": {
          "Path": "/api/pos/charge",
          "Headers": [
            {
              "Name": "X-Target-Bank",
              "Values": [ "GARANTI" ],
              "Mode": "ExactHeader"
            }
          ]
        }
      },
      "akbank-route": {
        "ClusterId": "akbank-cluster",
        "Match": {
          "Path": "/api/pos/charge",
          "Headers": [
            {
              "Name": "X-Target-Bank",
              "Values": [ "AKBANK" ],
              "Mode": "ExactHeader"
            }
          ]
        }
      },
      "ziraat-route": {
        "ClusterId": "ziraat-cluster",
        "Match": {
          "Path": "/api/pos/charge",
          "Headers": [
            {
              "Name": "X-Target-Bank",
              "Values": [ "ZIRAAT" ],
              "Mode": "ExactHeader"
            }
          ]
        }
      }
    },
    "Clusters": {
      "garanti-cluster": {
        "Destinations": {
          "garanti-node-1": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "akbank-cluster": {
        "Destinations": {
          "akbank-node-1": {
            "Address": "http://localhost:5002/"
          }
        }
      },
      "ziraat-cluster": {
        "Destinations": {
          "ziraat-node-1": {
            "Address": "http://localhost:5003/"
          }
        }
      }
    }
  }
}